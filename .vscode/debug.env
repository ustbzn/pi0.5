# Shared VS Code debug environment for DrivePi.
# Prefer repo-relative paths here so the config stays portable.

PYTHONPATH=.
LOG_DIR=./logs_debug
CUDA_VISIBLE_DEVICES=0
WANDB_DISABLED=true
PYTHONUNBUFFERED=1
HYDRA_FULL_ERROR=1
TF_CPP_MIN_LOG_LEVEL=3
TF_ENABLE_ONEDNN_OPTS=0

# Mode-specific config files.
DRIVEPI_DEBUG_TRAIN_CONFIG=config/train/DrivePi0/0421_qwen3_naviv2_9dim_smoothLoss_lora_vlm_1gpu_local.yaml
DRIVEPI_DEBUG_INFER_CONFIG=config/inference/DrivePi0/qwen_mogo_havetrain_vlm.yaml
DRIVEPI_DEBUG_EVAL_CONFIG=config/inference/DrivePi0/qwen_mogo_havetrain_vlm.yaml

# Fill these when your selected YAML still contains non-local absolute paths.
# TRAIN_DATA_DIR should point to the dataset root that contains train/ and val/.
DRIVEPI_DEBUG_PRETRAINED_MODEL_PATH=/pcpt/pcpt/project/lijun/.code/Qwen3-VL-2B-Instruct
DRIVEPI_DEBUG_TRAIN_DATA_DIR=/pcpt/pcpt/data/VLA/MOGO/mogo_dataset_navi_v2
DRIVEPI_DEBUG_VAL_DATA_DIR=/pcpt/pcpt/data/VLA/MOGO/mogo_dataset_navi_v2/val
DRIVEPI_DEBUG_STATISTICS_PATH=/pcpt/pcpt/data/VLA/MOGO/mogo_dataset_navi_v2/statistics_9dim.json
DRIVEPI_DEBUG_CHECKPOINT_PATH=/pcpt/pcpt/project/lijun/.code/qw3/Drive_pi/logs/train/drive-pi0/2026-04-23_19-47_mogo_naviv2_9dim_smoothLoss_lora_vlm_1gpu_local/checkpoint/step24920.pt
DRIVEPI_DEBUG_OUTPUT_DIR=./logs_debug/inference
