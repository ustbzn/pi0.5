{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "DrivePi: Train Debug",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/script/vscode_debug.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "/root/miniconda3/envs/drive_pi/bin/python",
      "justMyCode": false,
      "redirectOutput": true,
      "stopOnEntry": false,
      "envFile": "${workspaceFolder}/.vscode/debug.env",
      "args": [
        "--mode",
        "train",
        "--n-updates",
        "1",
        "--per-device-batch-size",
        "1"
      ]
    },
    {
      "name": "DrivePi: Train Debug (Resume)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/script/vscode_debug.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "/root/miniconda3/envs/drive_pi/bin/python",
      "justMyCode": false,
      "redirectOutput": true,
      "stopOnEntry": false,
      "envFile": "${workspaceFolder}/.vscode/debug.env",
      "args": [
        "--mode",
        "train",
        "--n-updates",
        "1",
        "--per-device-batch-size",
        "1",
        "--set",
        "resume_checkpoint_path=${input:resumeCheckpointPath}"
      ]
    },
    {
      "name": "DrivePi: Infer Debug",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/script/vscode_debug.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "/root/miniconda3/envs/drive_pi/bin/python",
      "justMyCode": false,
      "redirectOutput": true,
      "stopOnEntry": false,
      "envFile": "${workspaceFolder}/.vscode/debug.env",
      "args": [
        "--mode",
        "infer",
        "--max-samples",
        "1"
      ]
    },
    {
      "name": "DrivePi: Eval Debug",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/script/vscode_debug.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "/root/miniconda3/envs/drive_pi/bin/python",
      "justMyCode": false,
      "redirectOutput": true,
      "stopOnEntry": false,
      "envFile": "${workspaceFolder}/.vscode/debug.env",
      "args": [
        "--mode",
        "eval"
      ]
    },
    {
      "name": "DrivePi: Train Config Preview",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/script/vscode_debug.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "/root/miniconda3/envs/drive_pi/bin/python",
      "justMyCode": false,
      "redirectOutput": true,
      "stopOnEntry": false,
      "envFile": "${workspaceFolder}/.vscode/debug.env",
      "args": [
        "--mode",
        "train",
        "--print-config",
        "--no-run"
      ]
    }
  ],
  "inputs": [
    {
      "id": "resumeCheckpointPath",
      "type": "promptString",
      "description": "Checkpoint path for resume_checkpoint_path",
      "default": "logs/train/drive-pi0/<run_name>/checkpoint/stepXXXX.pt"
    }
  ]
}
